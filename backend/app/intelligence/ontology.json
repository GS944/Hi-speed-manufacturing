      "key_mode": "none",
      "weights": {},
      "required": [],
      "max_columns": 2,
      "min_rows": 1
    }
  },
  "stage_templates": [
    {
      "key": "received",
      "label": "Order Received",
      "requires": [
        "order_date"
      ],
      "when": {
        "present": "order_date"
      },
      "date_role": "order_date",
      "detail": "Order booked"
    },
    {
      "key": "issued",
      "label": "Material Issued",
      "requires": [
        "issued_qty"
      ],
      "when": {
        "gt": [
          "issued_qty",
          0
        ]
      },
      "qty_role": "issued_qty",
      "detail": "Raw material issued to production"
    },
    {
      "key": "job_work",
      "label": "Job Work / Operations",
      "source": "linked_ledger",
      "detail": "Operations at vendors (annexure DCs)"
    },
    {
      "key": "coating",
      "label": "Coating / Finishing",
      "requires_any": [
        "coating_date",
        "coating_qty"
      ],
      "when": {
        "any": [
          {
            "present": "coating_date"
          },
          {
            "gt": [
              "coating_qty",
              0
            ]
          }
        ]
      },
      "date_role": "coating_date",
      "qty_role": "coating_qty",
      "detail": "Coating and finishing"
    },
    {
      "key": "despatch",
      "label": "Despatched",
      "requires_any": [
        "despatch_qty",
        "despatch_date"
      ],
      "when": {
        "any": [
          {
            "gt": [
              "despatch_qty",
              0
            ]
          },
          {
            "present": "despatch_date"
          }
        ]
      },
      "date_role": "despatch_date",
      "qty_role": "despatch_qty",
      "detail": "Goods despatched to customer"
    }
  ],
  "completion_rules": [
    {
      "label": "Despatched quantity meets the order",
      "requires": [
        "despatch_qty",
        "order_qty"
      ],
      "when": {
        "gte": [
          "despatch_qty",
          "order_qty"
        ]
      }
    },
    {
      "label": "Despatched and no balance stock",
      "requires": [
        "despatch_qty",
        "stock_qty"
      ],
      "when": {
        "all": [
          {
            "gt": [
              "despatch_qty",
              0
            ]
          },
          {
            "lte": [
              "stock_qty",
              0
            ]
          }
        ]
      }
    },
    {
      "label": "Despatch date recorded",
      "requires": [
        "despatch_date"
      ],
      "only_if_missing": [
        "despatch_qty"
      ],
      "when": {
        "present": "despatch_date"
      }
    }
  ],
  "urgent_terms": [
    "emergency",
    "urgent",
    "immediate",
    "critical",
    "asap",
    "rush"
  ],
  "ledger_link": {
    "date_tolerance_days": 3
  }
}