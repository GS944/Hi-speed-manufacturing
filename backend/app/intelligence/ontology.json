  "kinds_note": "kind = value-distribution family used to synthesise training columns (see intelligence/synth.py)",
  "table_types": {
    "orders": {
      "label": "Order Book",
      "key_role": "order_no",
      "key_mode": "primary",
      "weights": {
        "order_no": 3,
        "order_date": 2,
        "order_qty": 2,
        "item_description": 1.5,
        "despatch_qty": 2,
        "due_date": 1,
        "issued_qty": 1,
        "customer_code": 1,
        "despatch_date": 1.5,
        "priority": 0.5,
        "coating_qty": 0.5
      },
      "required": [
        "order_no"
      ],
      "min_rows": 3
    },
    "job_work_ledger": {
      "label": "Job-Work / Annexure Ledger",
      "key_role": "order_no",
      "key_mode": "reference",
      "weights": {
        "operation": 3,
        "vendor_name": 2.5,
        "unit_cost": 2,
        "issue_date": 1.5,
        "value_of_goods": 1.5,
        "inward_date": 1,
        "inward_doc": 1,
        "hardness_checked": 1,
        "order_no": 1.5,
        "weight": 0.5,
        "hardness_spec": 0.5,
        "quantity": 0.5
      },
      "required": [
        "operation"
      ],
      "min_rows": 3
    },
    "vendor_master": {
      "label": "Vendor Master",
      "key_role": "vendor_name",
      "key_mode": "lookup",
      "weights": {
        "vendor_name": 2,
        "address": 3,
        "gstin": 2,
        "phone": 1
      },
      "required": [
        "address"
      ],
      "min_rows": 2
    },
    "customer_master": {
      "label": "Customer Master",
      "key_role": "customer_code",
      "key_mode": "lookup",
      "weights": {
        "customer_code": 3,
        "customer_name": 3,
        "colour_tag": 1
      },
      "required": [
        "customer_name"
      ],
      "min_rows": 2,
      "max_columns": 6
    },
    "price_list": {
      "label": "Price / Rate List",
      "key_role": "item_description",
      "key_mode": "lookup",
      "weights": {
        "unit_cost": 3,
        "old_price": 2,
        "item_description": 1.5,
        "size": 1
      },
      "required": [
        "unit_cost"
      ],
      "min_rows": 2
