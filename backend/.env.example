# Optional local overrides - copy to backend/.env. Nothing here is required.
# In production set these as environment variables on your host (see DEPLOYMENT.md).

# development | production   (production = API docs off, CORS must be set, HSTS)
ENV=development

# Accounts: people create their own account on the "Create account" page (any username/password) and sign in
# with it on every later visit. ALLOW_SIGNUP is the initial state of that page (switch it in Settings > Users).
ALLOW_SIGNUP=true
# Optional: also create an account from here on start-up (e.g. to regain access). Leave empty normally.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Session length in hours. JWT_SECRET is optional (otherwise generated once and stored in the database).
JWT_EXPIRE_HOURS=10
JWT_SECRET=

# Database: empty = SQLite file in DATA_DIR. Or a PostgreSQL URL (e.g. from Neon, free).
DATABASE_URL=
DATA_DIR=

# Workbook storage: empty = local folder DATA_DIR/files. Or an S3-compatible bucket (Backblaze B2 / Cloudflare R2).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_QUOTA_GB=10
MAX_UPLOAD_MB=200

# Browser origins allowed to call the API (your frontend URL), comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
