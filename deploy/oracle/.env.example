# Copy to deploy/oracle/.env on the server and fill in. Never commit the real .env.

# Your free DuckDNS address for this server (no https://, no slash)
DOMAIN=your-name.duckdns.org

ENV=production
CORS_ORIGINS=https://hi-speed-manufacturing.vercel.app

# Same values as on Render (Render > hi-speed-backend > Environment) so all data and accounts carry over
DATABASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
JWT_SECRET=

STORAGE_QUOTA_GB=9
MAX_UPLOAD_MB=200
